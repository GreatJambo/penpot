# Copy this file outside the repo, fill it in, and chmod 600.
# Point PENPOT_MCP_HEADLESS_ENV_FILE at that copy.
# Do not commit the copy. Do not put the live password in the repo.

# Origin the editor believes it is using.
PENPOT_PUBLIC_URI=https://penpot.zhanchengbo.com
# Where the sidecar actually sends that traffic. Leave unset only when
# the browser can open PENPOT_PUBLIC_URI directly.
PENPOT_INTERNAL_ORIGIN=http://penpot-frontend:8080

PENPOT_EMAIL=Chamberlainzhan@gmail.com
PENPOT_PASSWORD=

# Only when the browser itself must pass Cloudflare Access.
# Not used when PENPOT_INTERNAL_ORIGIN keeps traffic on the Docker network.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
