# Copy this file outside the repo, fill it in, and chmod 600.
# Point PENPOT_MCP_HEADLESS_ENV_FILE at that copy.
# Do not commit the copy. Do not put the live password in the repo.

PENPOT_PUBLIC_URI=http://penpot-frontend:8080
PENPOT_EMAIL=Chamberlainzhan@gmail.com
PENPOT_PASSWORD=

# Workspace the sidecar keeps open. The plugin can read and edit this
# file only. Change these and recreate the container to switch files.
PENPOT_TEAM_ID=
PENPOT_FILE_ID=
# PENPOT_PAGE_ID=

# Only if the public site is behind Cloudflare Access.
# Leave unset when the sidecar can open PENPOT_PUBLIC_URI directly.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
